# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Claude API key for reading pasted recipes (console.anthropic.com). Keep this one secret.
ANTHROPIC_API_KEY=

# Optional: each person's AI allowance per 7 days, in pence (default 100 = £1).
AI_WEEKLY_LIMIT_PENCE=

# Subscriptions (stripe.com) and the server-only Supabase key the Stripe webhook uses. Keep these secret.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
